# Base site URL without a trailing slash (used for SEO metadata, sitemap, and share links)
SITE_URL="https://aqurivo.store"
NEXT_PUBLIC_SITE_URL="https://aqurivo.store"
NEXT_PUBLIC_SITE_URL_COM="https://aqurivo.com"

# ==============================================================================
# SMTP Email Delivery Settings (e.g., Gmail App Password or custom SMTP)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-user@example.com"
SMTP_APP_PASSWORD=""
CONTACT_NOTIFICATION_EMAIL="contact@example.com"
SMTP_FROM_NAME="AQURIVO Contact Desk"

# ==============================================================================
# Firebase Client Web SDK Configuration (Public client configuration for your project)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_DATABASE_URL=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin SDK Credentials (Server-side only — never expose to the browser)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Data Store Selection ("firestore" or "turso"; both variables must match)
DATA_STORE="firestore"
NEXT_PUBLIC_DATA_STORE="firestore"
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# AQURIVO MCP stays local and read-only by default
AQURIVO_MCP_TARGET="local"
AQURIVO_MCP_ENABLE_WRITES="false"
AQURIVO_MCP_ALLOW_PRODUCTION_READS="false"
AQURIVO_MCP_ALLOW_PRODUCTION_WRITES="false"
AQURIVO_MCP_ALLOW_PRODUCTION_PRODUCT_WRITES="false"
AQURIVO_MCP_ALLOW_PRODUCTION_EDITORIAL_WRITES="false"
AQURIVO_MCP_ALLOW_DELETES="false"

# Backup encryption key (32+ random characters, separate from TURSO_AUTH_TOKEN)
FIRESTORE_BACKUP_ENCRYPTION_KEY=""

# Comma-separated list of verified admin email addresses allowed to access /admin
ADMIN_EMAILS="admin@example.com"

# Strong random secret (32+ characters, e.g., openssl rand -base64 32)
SESSION_COOKIE_SECRET=""

# Fixed 32+ character encryption key for stored AI provider & tool keys
# Do not change this value after saving keys, or existing encrypted keys cannot be decrypted.
AI_SECRETS_ENCRYPTION_KEY=""

# Random secret salt for daily one-way IP hashing (privacy-preserving click & rate-limit tracking)
IP_HASH_SALT=""

# Cloudinary Image Uploads (API key and secret are server-only for signed uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Amazon Product Advertising API 5.0 (Server-side only)
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_ASSOCIATE_TAG=""
AMAZON_REGION="us-east-1"

# Optional Canopy API keys (comma-separated, server-side only; also manageable from Admin Settings)
CANOPY_API_KEYS=""

# Optional Server-side AI & Hosting Runtime Variables
GEMINI_API_KEY=""
APP_URL=""
